# ══════════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in. Everything marked REQUIRED must be set or the bot
# exits on startup rather than coming up half-broken.
#
# This file is also your disaster-recovery checklist: the git mirror backs up
# code, never secrets. If you lose the hosting account, this is the list of
# things you need to recreate.
# ══════════════════════════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────────────── REQUIRED
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal chat ID (get it from @userinfobot)
TELEGRAM_CHAT_ID=

# ── Transport ─────────────────────────────────────────────────────────────────
# polling | webhook. Leave blank to auto-pick: webhook when a public URL is
# set, polling when it is not.
#
#   polling  — no public URL, no TLS, no tunnel. The bot connects out to
#              Telegram and pulls updates. Works behind NAT, on a laptop.
#              Best for local development.
#   webhook  — Telegram pushes to your domain. Lower latency, less chatter.
#              Best on a VPS with a real domain.
BOT_MODE=

# Public HTTPS origin Telegram posts webhook updates to. Required for webhook
# mode, ignored in polling mode. On Coolify this is the domain assigned to the
# service. No trailing slash.
#   e.g. https://bot.yourdomain.com
PUBLIC_URL=

# Aliases for the above, checked in this order after PUBLIC_URL. Only set one.
WEBHOOK_URL=
APP_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite. In Docker this MUST point at a mounted volume or every trade is lost
# on redeploy. The Dockerfile defaults it to the /data volume.
#   local dev:  file:./data/bot.db
#   container:  file:/data/bot.db
DATABASE_URL="file:./data/bot.db"

# Set true to log every SQL query (noisy; debugging only)
PRISMA_DEBUG=false

# ── Solana RPC ────────────────────────────────────────────────────────────────
# Primary endpoint. A paid RPC (QuickNode/Helius) is strongly recommended —
# the public endpoint is rate-limited hard enough to cost you fills.
QUICKNODE_RPC_URL=
SOLANA_RPC_URL=
SOLANA_BACKUP_RPC_URL=
SOLANA_RPC_URL_BACKUP=

# Jupiter swap API. Blank uses the public lite endpoint (rate-limited).
QUICKNODE_JUPITER_URL=

# ── Helius ────────────────────────────────────────────────────────────────────
# Required for on-chain pattern recognition (holders, deployer history).
HELIUS_API_KEY=

# ── Groq (optional, but easy to miss) ─────────────────────────────────────────
# Scores how compelling a token's story/lore is. A score of 70+ adds a +15
# alpha boost, which can lift a 55-69 token over the entry threshold.
#
# Without this the boost NEVER fires and those tokens are skipped silently —
# no error, no log line. Everything else works normally; you are just running
# with one scoring signal permanently off. Free tier at console.groq.com.
GROQ_API_KEY=

# ── Wallet ────────────────────────────────────────────────────────────────────
# Only needed for LIVE mode. DEMO mode runs fine with no wallet at all.
# Base58 private key, same format as a Phantom export.
WALLET_PRIVATE_KEY=
SOLANA_WALLET_PRIVATE_KEY=

# 64-char hex AES-256 key encrypting the wallet stored in the DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted it is derived from TELEGRAM_BOT_TOKEN — which means rotating the
# bot token makes any stored wallet undecryptable. Set it explicitly.
WALLET_ENCRYPTION_KEY=

# ── Trading mode ──────────────────────────────────────────────────────────────
# Mode is stored in the database and changed with /mode, not here. A fresh
# install defaults to DEMO so it can never fire real buys before you opt in.

# Simulated starting balance for a new demo account, in SOL.
DEMO_STARTING_BALANCE_SOL=10

# Friction applied to simulated fills. Do not set these to 0 — a frictionless
# demo makes every strategy look profitable and hides that slippage on thin
# pools is often the entire edge.
DEMO_SLIPPAGE_BPS=150
DEMO_FEE_SOL=0.00035

# ── Execution speed ───────────────────────────────────────────────────────────
# How often open positions are checked for TP/SL, in ms. This is the dominant
# term in stop-loss latency — it is how long a position can sit unchecked after
# a price move. Sub-second works but starts tripping upstream rate limits once
# you hold several positions at once.
RISK_LOOP_MS=1000

# Slow loop: alert tracking, milestone cards, delayed entries.
MONITOR_LOOP_MS=30000

# Price fetch tuning.
PRICE_CACHE_TTL_MS=600
PRICE_TIMEOUT_MS=2500

# ── Transaction submission (advanced) ─────────────────────────────────────────
# How hard the bot works to get a signed transaction to land. Defaults are
# sensible; these exist for tuning against a flaky RPC.

# Attempts per RPC call before failing over to the next endpoint.
MAX_RPC_RETRIES=5

# The same signed transaction is re-broadcast this many times. Solana dedupes
# by signature so this cannot double-execute — it only raises the odds of the
# tx landing when the network drops the first send.
BLAST_COUNT=4
BLAST_INTERVAL_MS=2000

# Retries of the raw send within a single endpoint.
RPC_SEND_RETRIES=3

# Preflight simulation is SKIPPED by default, because it costs latency.
# Set true when buys appear to send but never land — preflight surfaces the
# pre-execution errors (bad instruction, missing account, stale route) that
# are otherwise silently swallowed. First thing to try when debugging fills.
DEBUG_PREFLIGHT=false

# ── Robinhood chain (pons launchpad) ──────────────────────────────────────────
# Has a working default. The listener is currently disabled in code regardless,
# so this only matters if you re-enable startPonsFactoryListener().
ROBINHOOD_RPC_URL=

# ── Chart ─────────────────────────────────────────────────────────────────────
# P&L chart uses a colourblind-safe blue/orange pair by default. Set true for
# conventional green/red (fails deuteranopia separation — only if that is fine
# for you).
PNL_CLASSIC_COLORS=false

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Purely a history cache now. Leave blank on a single-container deploy; the bot
# runs on SQLite alone and will say so at startup.
REDIS_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=10000

# ── Legacy host aliases (ignored unless PUBLIC_URL is unset) ──────────────────
RENDER_EXTERNAL_URL=
RAILWAY_STATIC_URL=
